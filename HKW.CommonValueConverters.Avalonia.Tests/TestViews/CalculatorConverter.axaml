<t:TestTarget
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:t="using:HKW.CommonValueConverters.Avalonia.Tests"
  xmlns:c="using:HKW.CommonValueConverters.Avalonia"
  x:CompileBindings="False"
>
  <t:TestTarget.Resources>
    <c:CalculatorConverter x:Key="CalculatorConverter"></c:CalculatorConverter>
  </t:TestTarget.Resources>
  <t:TestTarget.Result>
    <Binding
      Path="V0"
      Mode="OneWay"
      Converter="{StaticResource CalculatorConverter}"
      ConverterParameter="+8"
    />
  </t:TestTarget.Result>
</t:TestTarget>
