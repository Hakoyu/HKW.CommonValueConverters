<t:TestTarget xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:t="using:HKW.CommonValueConverters.Avalonia.Tests" xmlns:c="using:HKW.CommonValueConverters.Avalonia"
    x:CompileBindings="False">
  <t:TestTarget.Resources><c:CollectionCountCompareByConverter x:Key="CollectionCountCompareByConverter" ></c:CollectionCountCompareByConverter></t:TestTarget.Resources>
  <t:TestTarget.Result><Binding Path="V0" Mode="OneWay" Converter="{StaticResource CollectionCountCompareByConverter}" ConverterParameter="&gt;2" /></t:TestTarget.Result>
</t:TestTarget>
