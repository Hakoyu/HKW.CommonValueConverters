<t:TestTarget
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:t="using:HKW.CommonValueConverters.Avalonia.Tests"
  xmlns:c="using:HKW.CommonValueConverters.Avalonia"
  x:CompileBindings="False"
>
  <t:TestTarget.Resources>
    <c:CalculatorMultiConverter x:Key="CalculatorMultiConverter"></c:CalculatorMultiConverter>
  </t:TestTarget.Resources>
  <t:TestTarget.Result>
    <MultiBinding Converter="{StaticResource CalculatorMultiConverter}" ConverterParameter="+">
      <Binding Path="V0" /><Binding Path="V1" />
    </MultiBinding>
  </t:TestTarget.Result>
</t:TestTarget>
