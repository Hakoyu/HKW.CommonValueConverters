<t:TestTarget
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:t="using:HKW.CommonValueConverters.Avalonia.Tests"
  xmlns:c="using:HKW.CommonValueConverters.Avalonia"
  x:CompileBindings="False"
>
  <t:TestTarget.Resources>
    <t:StringAnyEqualsMultiConverter
      x:Key="AnyEqualsMultiConverter_String"
      Value="match"
    ></t:StringAnyEqualsMultiConverter>
  </t:TestTarget.Resources>
  <t:TestTarget.Result>
    <MultiBinding Converter="{StaticResource AnyEqualsMultiConverter_String}">
      <Binding Path="V0" /><Binding Path="V1" />
    </MultiBinding>
  </t:TestTarget.Result>
</t:TestTarget>
