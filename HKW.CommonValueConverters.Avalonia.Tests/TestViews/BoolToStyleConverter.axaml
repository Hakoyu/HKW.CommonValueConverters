<t:TestTarget xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:t="using:HKW.CommonValueConverters.Avalonia.Tests" xmlns:c="using:HKW.CommonValueConverters.Avalonia"
    x:CompileBindings="False">
  <t:TestTarget.Resources><c:BoolToStyleConverter x:Key="BoolToStyleConverter" ><c:BoolToStyleConverter.TrueValue><Style Selector="Control"><Setter Property="Tag" Value="yes-style" /></Style></c:BoolToStyleConverter.TrueValue><c:BoolToStyleConverter.FalseValue><Style Selector="Control"><Setter Property="Tag" Value="no-style" /></Style></c:BoolToStyleConverter.FalseValue></c:BoolToStyleConverter></t:TestTarget.Resources>
  <t:TestTarget.Result><Binding Path="V0" Mode="OneWay" Converter="{StaticResource BoolToStyleConverter}" /></t:TestTarget.Result>
</t:TestTarget>
