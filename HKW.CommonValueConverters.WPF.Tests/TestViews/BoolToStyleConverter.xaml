<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:HKW.CommonValueConverters.WPF;assembly=HKW.CommonValueConverters.WPF"
  xmlns:t="clr-namespace:HKW.CommonValueConverters.WPF.Tests"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
>
  <DataTemplate x:Key="BoolToStyleConverter">
    <Grid>
      <Grid.Resources>
        <c:BoolToStyleConverter x:Key="Converter">
          <c:BoolToStyleConverter.TrueValue>
            <Style TargetType="FrameworkElement">
              <Setter Property="Opacity" Value="0.25" />
            </Style>
          </c:BoolToStyleConverter.TrueValue>
          <c:BoolToStyleConverter.FalseValue>
            <Style TargetType="FrameworkElement">
              <Setter Property="Opacity" Value="0.75" />
            </Style>
          </c:BoolToStyleConverter.FalseValue>
        </c:BoolToStyleConverter>
      </Grid.Resources>
      <t:TestTarget x:Name="Target">
        <t:TestTarget.Result>
          <Binding
            Path="A"
            Converter="{StaticResource Converter}"
            Mode="OneWay"
            ConverterCulture="en-US"
          />
        </t:TestTarget.Result>
      </t:TestTarget>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
