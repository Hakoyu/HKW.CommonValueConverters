<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:HKW.CommonValueConverters.WPF;assembly=HKW.CommonValueConverters.WPF"
  xmlns:t="clr-namespace:HKW.CommonValueConverters.WPF.Tests"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
>
  <DataTemplate x:Key="EqualsCountMultiConverter_String">
    <Grid>
      <Grid.Resources>
        <t:StringEqualsCountConverter x:Key="Converter" Value="match" />
      </Grid.Resources>
      <t:TestTarget x:Name="Target">
        <t:TestTarget.Result>
          <MultiBinding
            Converter="{StaticResource Converter}"
            Mode="OneWay"
            ConverterCulture="en-US"
          >
            <Binding Path="A" />
            <Binding Path="B" />
          </MultiBinding>
        </t:TestTarget.Result>
      </t:TestTarget>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="EqualsCountMultiConverter">
    <Grid>
      <Grid.Resources>
        <c:EqualsCountMultiConverter x:Key="Converter" Value="match" />
      </Grid.Resources>
      <t:TestTarget x:Name="Target">
        <t:TestTarget.Result>
          <MultiBinding
            Converter="{StaticResource Converter}"
            Mode="OneWay"
            ConverterCulture="en-US"
          >
            <Binding Path="A" />
            <Binding Path="B" />
          </MultiBinding>
        </t:TestTarget.Result>
      </t:TestTarget>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
