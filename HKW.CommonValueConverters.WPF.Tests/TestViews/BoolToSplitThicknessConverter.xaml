<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:HKW.CommonValueConverters.WPF;assembly=HKW.CommonValueConverters.WPF"
  xmlns:t="clr-namespace:HKW.CommonValueConverters.WPF.Tests"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
>
  <DataTemplate x:Key="BoolToSplitThicknessConverter">
    <Grid>
      <Grid.Resources>
        <c:BoolToSplitThicknessConverter x:Key="Converter" Separator="|" />
      </Grid.Resources>
      <t:TestTarget x:Name="Target">
        <t:TestTarget.Result>
          <Binding
            Path="A"
            Converter="{StaticResource Converter}"
            Mode="OneWay"
            ConverterCulture="en-US"
            ConverterParameter="1,2,3,4|5|0"
          />
        </t:TestTarget.Result>
      </t:TestTarget>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
