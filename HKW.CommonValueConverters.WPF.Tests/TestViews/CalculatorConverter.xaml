<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:HKW.CommonValueConverters.WPF;assembly=HKW.CommonValueConverters.WPF"
  xmlns:t="clr-namespace:HKW.CommonValueConverters.WPF.Tests"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
>
  <DataTemplate x:Key="CalculatorConverter">
    <Grid>
      <Grid.Resources>
        <c:CalculatorConverter x:Key="Converter" />
      </Grid.Resources>
      <t:TestTarget x:Name="Target">
        <t:TestTarget.Result>
          <Binding
            Path="A"
            Converter="{StaticResource Converter}"
            Mode="OneWay"
            ConverterCulture="en-US"
            ConverterParameter="+3"
          />
        </t:TestTarget.Result>
      </t:TestTarget>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
